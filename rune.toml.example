# Rune Configuration Example (`rune.toml`)
# Copy this file to `rune.toml` in your project root or home directory.

# Choose default active provider: "gemini", "openai", "groq", "openrouter", "anthropic", "ollama", or "lmstudio"
provider = "gemini"

# API Keys
gemini_api_key = ""
gemini_min_request_interval_ms = 1000
# Optional; set this below the TPM quota for your Gemini model/account.
# Estimates are conservative and may differ from Google's tokenizer.
# gemini_max_input_tokens_per_minute = 100000
openai_api_key = ""
groq_api_key = ""
openrouter_api_key = ""
anthropic_api_key = ""

# Model Choices
gemini_model = "gemini-3.5-flash-lite"
openai_model = "gpt-5.6-luna"
groq_model = "openai/gpt-oss-120b"
openrouter_model = "openai/gpt-4o-mini"
anthropic_model = "claude-3-5-sonnet"

# Paths excluded from Rune's built-in read-only file tools. Patterns are
# case-insensitive; * and ? are wildcards. A pattern without / matches any
# path component. Excluded files can still be edited by write/patch tools.
# excluded_read_paths = [".env", ".env.*", "*.pem", "secrets/**"]

# Local Endpoints (Ollama / LM Studio)
ollama_base_url = "http://localhost:11434"
ollama_model = "llama3"

lm_studio_base_url = "http://localhost:1234/v1"
lm_studio_model = "local-model"

# Multi-Agent Role Model Overrides
architect_model = "gemini-3.5-flash-lite"
coder_model = "gpt-5.6-luna"

# Optional Python automations. Scripts run as child processes with your user
# permissions; review each script before approving it in Rune.
# python_interpreter = "py" # Windows launcher; use "python3" on macOS/Linux
# python_args = ["-3"] # Optional interpreter arguments, e.g. ["-3"] for py
# automation_timeout_seconds = 30
# automation_max_output_bytes = 8192 # Limit per output stream (stdout/stderr)
#
# [[automations]]
# name = "morning-brief"
# script = ".rune/automations/morning_brief.py"
# enabled = true
# trigger = "startup" # "manual", "startup", "interval", or "scheduled"
# For trigger = "interval", set interval_seconds (minimum 1).
# interval_seconds = 1800
# For trigger = "scheduled", set daily local times in 24-hour HH:MM format.
# schedule_times = ["08:30", "13:00"]
